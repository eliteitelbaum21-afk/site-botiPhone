# OpenAI API key for the AI chat widget (required in production for /api/chat)
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# CRM lead intake. Key from pbx.botiphone.com → הגדרות → קליטת לידים (starts with bk_, shown once).
# Both the contact form and the chat widget POST to /api/public/leads.
LEADS_API_KEY=bk_PLmb-vVmxrXBgt85Q4VSfzmW1Ysc28X1
# Optional. Overrides the key's default source. Leave empty to use the key default.
# LEADS_SOURCE_ID=
# Optional. Defaults to https://pbx.botiphone.com/api/public/leads
# LEADS_API_URL=
# Public site URL (used for canonical links, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://www.botiphone.com
