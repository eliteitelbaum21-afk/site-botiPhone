# OpenAI API key for the AI chat widget (required in production for /api/chat)
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# SMTP settings for the contact form (optional - leads are always saved to data/leads.jsonl)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where contact form leads are sent
CONTACT_EMAIL=support@botiphone.com
# Public site URL (used for canonical links, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://www.botiphone.com
